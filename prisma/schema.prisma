  partnerId      String
  shopExternalId String?
  jokoUserId     String
  name           String?
  role           String   @default("agent")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User                   @relation(fields: [jokoUserId], references: [id], onDelete: Cascade)
  threads PartnerSupportThread[]

  @@unique([partnerId, jokoUserId])
  @@index([partnerId, shopExternalId])
}

model PartnerSupportThread {
  id              String    @id @default(cuid())
  partnerId       String
  shopExternalId  String?
  orderId         String?
  customerPhone   String
  customerUserId  String?
  mboloThreadId   String?
  status          String    @default("open")
  assignedAgentId String?
  subject         String?
  metadataJson    String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignedAgent PartnerSupportAgent? @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)

  @@index([partnerId, status, updatedAt])
  @@index([customerPhone])
  @@index([orderId])
  @@index([mboloThreadId])
}

model ApiIdempotency {
  id           String   @id @default(cuid())
  key          String   @unique
  provider     String
  userId       String
  operation    String
  reference    String?
  status       String   @default("pending")
  responseJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([reference])
}

model ApiAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  method     String
  path       String
  statusCode Int?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model UserRateLimit {
  userId       String    @id
  windowStart  DateTime
  requestCount Int       @default(0)
  blockedUntil DateTime?
  flagCount    Int       @default(0)
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDevice {
  id          String    @id @default(cuid())
  userId      String
  deviceId    String
  deviceName  String?
  ip          String?
  countryCode String?
  verifiedAt  DateTime?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
}

model HeldTransaction {
  id             String    @id @default(cuid())
  userId         String
  operationType  String
  status         String    @default("pending_review")
  amountNational Int
  payloadJson    String
  flagsJson      String
  userMessage    String
  reviewNote     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  reference      String    @unique
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  fraudAlerts FraudAlert[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([expiresAt])
}

model FraudAlert {
  id                String    @id @default(cuid())
  userId            String
  heldTransactionId String?
  severity          String    @default("high")
  code              String
  message           String
  acknowledgedAt    DateTime?
  createdAt         DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  heldTransaction HeldTransaction? @relation(fields: [heldTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([heldTransactionId])
  @@index([acknowledgedAt])
}

model CniVerificationJob {
  id                  String    @id @default(cuid())
  userId              String
  provider            String
  externalJobId       String?
  status              String    @default("pending")
  verifiedLegalName   String?
  verifiedDateOfBirth DateTime?
  documentNumberHash  String?
  failureReason       String?
  submittedAt         DateTime  @default(now())
  completedAt         DateTime?
  imagesPurgedAt      DateTime?
  purgeImagesAt       DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([externalJobId])
  @@index([purgeImagesAt])
}

model UserDailyUsage {
  userId          String
  usageDate       String
  sentNational    Int      @default(0)
  cashOutNational Int      @default(0)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, usageDate])
}

/**
 * Audit log for inbound/outbound SMS — balance queries, receive alerts, OTP.
 */
model SmsMessage {
  id         String   @id @default(cuid())
  userId     String?
  phone      String
  direction  String
  body       String
  provider   String?
  externalId String?
  status     String   @default("queued")
  purpose    String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([userId, createdAt])
  @@index([purpose, createdAt])
}

/**
 * Immutable audit trail for cron reports, integrity alerts, compliance.
 */
model SecureLog {
  id          String   @id @default(cuid())
  category    String
  severity    String   @default("info")
  title       String
  payloadJson String
  createdAt   DateTime @default(now())

  @@index([category, createdAt])
  @@index([severity, createdAt])
}

/**
 * Separate admin operators — not linked to app User accounts.
 */
model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String?
  totpSecretEnc   String?
  totpEnabled     Boolean   @default(false)
  totpConfirmedAt DateTime?
  active          Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions  AdminSession[]
  auditLogs AdminAuditLog[]
  tickets   SupportTicket[]        @relation("TicketAssignee")
  messages  SupportTicketMessage[]
  refunds   AdminRefund[]
  supportCallLogs SupportCallLog[]

  @@index([active])
}

model AdminSession {
  id           String    @id @default(cuid())
  adminUserId  String
  tokenHash    String    @unique
  totpVerified Boolean   @default(false)
  expiresAt    DateTime
  revokedAt    DateTime?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String?
  targetId    String?
  detailJson  String?
  createdAt   DateTime @default(now())

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
}

model SupportTicket {
  id              String    @id @default(cuid())
  userId          String
  subject         String
  status          String    @default("open")
  priority        String    @default("normal")
  channel         String    @default("app")
  csPhone         String?
  assignedAdminId String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignee AdminUser?             @relation("TicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages SupportTicketMessage[]
  callLogs SupportCallLog[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([channel, createdAt])
  @@index([assignedAdminId])
}

model SupportTicketMessage {
  id            String   @id @default(cuid())
  ticketId      String
  authorType    String
  authorAdminId String?
  authorUserId  String?
  body          String
  createdAt     DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin  AdminUser?    @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)
  user   User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

/** Inbound/outbound customer-service call log (phone, WhatsApp, etc.). */
model SupportCallLog {
  id          String   @id @default(cuid())
  phone       String
  userId      String?
  ticketId    String?
  adminUserId String?
  direction   String   @default("inbound")
  durationSec Int?
  outcome     String?
  note        String?
  createdAt   DateTime @default(now())

  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  ticket SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  admin  AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([phone])
  @@index([userId])
}

/**
 * Admin-issued refunds — always via ledger transfer, never direct balance patch.
 */
model AdminRefund {
  id              String   @id @default(cuid())
  adminUserId     String
  recipientUserId String
  amount          Int
  currency        String   @default("national")
  reason          String
  ledgerReference String   @unique
  originalRef     String?
  status          String   @default("completed")
  createdAt       DateTime @default(now())

  admin     AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  recipient User      @relation("RefundRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, createdAt])
  @@index([adminUserId, createdAt])
}

/**
 * 60-second undo window for P2P and merchant payments — reversal is atomic.
 */
model TransferUndo {
  id                 String    @id @default(cuid())
  senderUserId       String
  recipientUserId    String
  amount             Int
  currency           String    @default("national")
  operationType      String    @default("send")
  originalReference  String    @unique
  recipientReference String
  reversibleUntil    DateTime
  status             String    @default("active")
  reversedAt         DateTime?
  reversedReference  String?   @unique
  createdAt          DateTime  @default(now())

  sender    User @relation("UndoSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  recipient User @relation("UndoRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@index([senderUserId, status])
  @@index([recipientUserId])
  @@index([reversibleUntil])
}

/** Payroll group — HR, corporate, staff, farmers, etc. */
model PayrollGroup {
  id               String   @id @default(cuid())
  businessId       String
  name             String
  defaultPayAmount Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employees PayrollEmployee[]

  @@index([businessId])
}

/** Employee on a business payroll (includes cooperative farmers). */
model PayrollEmployee {
  id            String    @id @default(cuid())
  businessId    String
  userId        String
  groupId       String?
  jobTitle      String?
  payAmount     Int?
  paySchedule   String    @default("manual")
  payDayOfWeek  Int?
  payDayOfMonth Int?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User          @relation("PayrollEmployeeUser", fields: [userId], references: [id], onDelete: Cascade)
  group    PayrollGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  payRuns  PayrollRun[]

  @@unique([businessId, userId])
  @@index([businessId, status])
  @@index([userId])
  @@index([groupId])
}

/** Record of a payroll payment. */
model PayrollRun {
  id          String    @id @default(cuid())
  businessId  String
  employeeId  String
  amount      Int
  status      String    @default("completed")
  reference   String    @unique
  note        String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  employee PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([employeeId, createdAt])
}

/** Student enrolled at a school institution. */
model SchoolStudent {
  id           String   @id @default(cuid())
  businessId   String
  studentName  String
  parentUserId String
  gradeLabel   String?
  externalId   String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent   User                @relation("SchoolParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  payments SchoolFeePayment[]

  @@index([businessId, status])
  @@index([parentUserId])
}

/** Monthly or term fee period for a school. */
model SchoolFeePeriod {
  id         String   @id @default(cuid())
  businessId String
  label      String
  amount     Int
  dueDate    DateTime
  status     String   @default("open")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments SchoolFeePayment[]

  @@index([businessId, status])
  @@index([dueDate])
}

/** Parent fee payment for a student in a period. */
model SchoolFeePayment {
  id             String    @id @default(cuid())
  periodId       String
  studentId      String
  parentUserId   String
  amount         Int
  status         String    @default("pending")
  paidAt         DateTime?
  ledgerReference String?  @unique
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  period  SchoolFeePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  student SchoolStudent   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([periodId, studentId])
  @@index([parentUserId, status])
  @@index([periodId, status])
}

/** Farmer delivery log for cooperatives — verified in person, syncs offline. */
model FarmerDeliveryLog {
  id               String    @id @default(cuid())
  businessId       String
  farmerUserId     String
  quantityTons     Float
  periodStart      DateTime
  periodEnd        DateTime
  verifiedByUserId String?
  verifiedAt       DateTime?
  status           String    @default("pending")
  note             String?
  offlineClientId  String?   @unique
  payoutReference  String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  farmer     User     @relation("FarmerDeliveries", fields: [farmerUserId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("VerifiedDeliveries", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([farmerUserId, createdAt])
}

/** User blocked another user or business. */
model UserBlock {
  id                String   @id @default(cuid())
  blockerId         String
  blockedUserId     String?
  blockedBusinessId String?
  createdAt         DateTime @default(now())

  blocker         User      @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser     User?     @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blockedBusiness Business? @relation(fields: [blockedBusinessId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@unique([blockerId, blockedBusinessId])
  @@index([blockerId])
}

/** User report — routed to K21 admin review queue. */
model ContentReport {
  id                String   @id @default(cuid())
  reporterId        String
  targetUserId      String?
  targetBusinessId  String?
  category          String
  reason            String
  status            String   @default("open")
  adminNotes        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reporter       User      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser     User?     @relation("ReportedUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetBusiness Business? @relation(fields: [targetBusinessId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetUserId])
  @@index([targetBusinessId])
}

/** Friend link — bidirectional rows (A→B and B→A). */
model UserFriend {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("FriendUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

/**
 * WeChat-style friend request: friendship starts as a request the other
 * person must accept. Accepting is KYC-gated (name + verified phone today,
 * CNI later via FRIEND_GATE_REQUIRES_CNI).
 */
model FriendRequest {
  id          String    @id @default(cuid())
  fromId      String
  toId        String
  message     String?
  status      String    @default("pending") // pending | accepted | declined
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  from User @relation("FriendRequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("FriendRequestTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId, status])
}

/**
 * Community anti-spam vouch: a member whose account is 6+ months old scans
 * your QR to confirm you're a real person. One vouch = "confirmé" badge.
 */
model UserVouch {
  id        String   @id @default(cuid())
  userId    String // the person being confirmed
  voucherId String // the 6-month+ member who scanned them
  createdAt DateTime @default(now())

  user    User @relation("VouchReceived", fields: [userId], references: [id], onDelete: Cascade)
  voucher User @relation("VouchGiven", fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([userId, voucherId])
  @@index([userId])
}

/** Offline-first queue — cooperative delivery logs, etc. */
model OfflineSyncQueue {
  id         String    @id @default(cuid())
  userId     String
  entityType String
  payload    String
  clientId   String    @unique
  syncedAt   DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, syncedAt])
  @@index([entityType])
}

/** K21 Charts — community favorite-song chart. One vote per user per week. */
model ChartSong {
  id          String   @id @default(cuid())
  weekKey     String
  titleKey    String
  title       String
  artist      String
  videoId     String?
  submittedBy String?
  createdAt   DateTime @default(now())

  votes SongVote[]

  @@unique([weekKey, titleKey])
  @@index([weekKey])
}

model SongVote {
  id        String   @id @default(cuid())
  songId    String
  userId    String
  weekKey   String
  createdAt DateTime @default(now())

  song ChartSong @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([songId])
}

/** Cached external trending data (YouTube SN music, etc.) refreshed by cron. */
model TrendingCache {
  id        String   @id @default(cuid())
  kind      String
  periodKey String
  rank      Int
  title     String
  meta      String?
  url       String?
  createdAt DateTime @default(now())

  @@unique([kind, periodKey, rank])
  @@index([kind, periodKey])
}

/** Real merchant reviews — one per user per business, no fake ratings ever. */
model Review {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  rating     Int
  text       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
}

/** Profile poll — a member asks one question, friends vote. One active poll
 * per user (asking a new one closes the previous). */
model UserPoll {
  id        String   @id @default(cuid())
  userId    String
  question  String
  options   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  votes UserPollVote[]

  @@index([userId, active])
}

model UserPollVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  optionIx  Int
  createdAt DateTime @default(now())

  poll UserPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
}

/** Channels — WeChat-style: each account can create exactly ONE channel;
 * others follow it and watch what it posts. */
model Channel {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  name      String
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts     ChannelPost[]
  followers ChannelFollow[]
}

model ChannelPost {
  id        String   @id @default(cuid())
  channelId String
  body      String?
  imageUrl  String?
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model ChannelFollow {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

/** K21 in-person agent — float-backed cash-in/out at agent points. */
model AgentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  agentCode     String   @unique
  displayName   String
  locationLabel String?
  arrondissement  String?
  lat             Float?
  lng             Float?
  /** standard = retail point; business = large float / gros retraits */
  tier               String   @default("standard")
  floatBalance       Int      @default(0)
  floatLimit         Int      @default(500000)
  maxDepositXof      Int      @default(500000)
  maxWithdrawXof     Int      @default(500000)
  commissionBps      Int      @default(100)
  monthlyFlatFeeXof  Int      @default(25000)
  volumeBonusBps     Int      @default(50)
  status             String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  deposits     AgentDeposit[]
  withdrawals  AgentWithdrawal[]
  floatEntries AgentFloatEntry[]
  payouts      AgentPayout[]
  floatTopUpRequests AgentFloatTopUpRequest[]

  @@index([status])
  @@index([tier])
  @@index([lat, lng])
}

/** Self-service float recharge request — an admin still approves it, but
 * the agent no longer has to leave the app to ask for one. */
model AgentFloatTopUpRequest {
  id           String    @id @default(cuid())
  agentId      String
  amountXof    Int
  note         String?
  status       String    @default("pending")
  adminId      String?
  responseNote String?
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?

  agent AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@index([status])
}

/** Monthly agent compensation — flat fee + volume bonus on processed cash-ins. */
model AgentPayout {
  id              String   @id @default(cuid())
  agentId         String
  periodYear      Int
  periodMonth     Int
  totalVolumeXof  Int      @default(0)
  depositCount    Int      @default(0)
  flatFeeXof      Int      @default(0)
  volumeBonusXof  Int      @default(0)
  totalPaidXof    Int      @default(0)
  status          String   @default("paid")
  reference       String   @unique
  createdAt       DateTime @default(now())

  agent AgentProfile @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@unique([agentId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

model AgentDeposit {
  id          String    @id @default(cuid())
  reference   String    @unique
  token       String    @unique
  userId      String
  agentId     String?
  amountXof   Int
  status      String    @default("pending")
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  agent AgentProfile? @relation(fields: [agentId], references: [id])

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([status, expiresAt])
}

model AgentWithdrawal {
  id          String    @id @default(cuid())
  reference   String    @unique
  token       String    @unique
  userId      String
  agentId     String?
  amountXof   Int
  status      String    @default("pending")
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  agent AgentProfile? @relation(fields: [agentId], references: [id])

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([status, expiresAt])
}

model AgentFloatEntry {
  id           String   @id @default(cuid())
  agentId      String
  type         String
  amountXof    Int
  balanceAfter Int
  reference    String   @unique
  depositId    String?
  withdrawalId String?
  note         String?
  adminId      String?
  createdAt    DateTime @default(now())

  agent AgentProfile @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([agentId, createdAt])
  @@index([type])
}

/** Stripe card deposit (diaspora) — settled via webhook. */
model StripeDeposit {
  id                    String    @id @default(cuid())
  userId                String
  amountXof             Int
  amountEurCents        Int
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?   @unique
  status                String    @default("pending")
  reference             String    @unique
  createdAt             DateTime  @default(now())
  completedAt           DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
}

/** TikTok-style affiliate — earn commission when referred users purchase. */
model AffiliateProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  affiliateCode String   @unique
  displayName   String?
  commissionBps Int      @default(500)
  totalEarned   Int      @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  links        AffiliateLink[]
  commissions  AffiliateCommission[]

  @@index([status])
}

model AffiliateLink {
  id          String   @id @default(cuid())
  affiliateId String
  productId   String?
  businessId  String?
  linkCode    String   @unique
  label       String?
  clickCount  Int      @default(0)
  orderCount  Int      @default(0)
  createdAt   DateTime @default(now())

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  product   Product?         @relation(fields: [productId], references: [id])
  business  Business?        @relation(fields: [businessId], references: [id])

  @@index([affiliateId])
  @@index([businessId])
  @@index([productId])
}

model AffiliateCommission {
  id             String   @id @default(cuid())
  affiliateId    String
  orderId        String?
  buyerId        String
  amount         Int
  orderTotal     Int
  commissionBps  Int
  source         String
  linkCode       String?
  productId      String?
  businessId     String?
  mboloThreadId  String?
  mboloMessageId String?
  status         String   @default("paid")
  reference      String   @unique
  createdAt      DateTime @default(now())

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([affiliateId, createdAt])
  @@index([buyerId])
  @@index([orderId])
}

/// Fixed-window request counters for unauthenticated/per-identifier rate limits
/// (lib/request-limits.js). Shared across serverless instances via Postgres.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

/// Append-only audit of credential remediation (never contains credentials,
/// hashes, OTPs or reset secrets).
model CredentialSecurityEvent {
  id         String   @id @default(cuid())
  userId     String
  /// exposure_marked | pin_invalidated | password_invalidated | sessions_revoked
  /// | pin_reestablished | password_reestablished
  type       String
  /// admin | operator_script | system | user
  actorType  String
  actorId    String?
  reason     String?
  /// A | B (classification from the exposure investigation), if applicable
  classification String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

