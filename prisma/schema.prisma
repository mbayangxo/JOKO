generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  phone                  String    @unique
  country                String    @default("SN")
  name                   String?
  handle                 String?   @unique
  statusText             String?
  currentSong            String?
  pinnedPhotos           Json?
  arrondissementKey      String?
  arrondissementIcon     String?
  arrondissementName     String?
  avatarEmoji            String?
  avatarUrl              String?   @db.Text
  identityChoice         String?
  otpVerifiedAt          DateTime?
  pinHash                String?
  passwordHash           String?
  pinFailedAttempts      Int       @default(0)
  accountLockedAt        DateTime?
  accountLockReason      String?
  frozenByAdminAt        DateTime?
  adminFreezeReason      String?
  /// Set when access is recovered via OTP; opens a 24h cool-off on outbound money.
  accountRecoveredAt     DateTime?
  /// Credential remediation: set when this account's PIN/password must be
  /// re-established (e.g. hashes were exposed). Outbound money is held and new
  /// credentials require a fresh OTP login AFTER this timestamp.
  credentialResetRequiredAt DateTime?
  credentialResetReason     String?
  /// Access tokens issued (iat) before this instant are rejected (session revocation).
  sessionsRevokedAt         DateTime?
  lastActivityAt         DateTime?
  cniNumberEnc           String?
  biometricEnabled       Boolean   @default(false)
  stepUpVerifiedAt       DateTime?
  isDiaspora             Boolean   @default(false)
  verificationTier       Int       @default(1)
  verificationStatus     String    @default("phone_only")
  cniVerifiedAt          DateTime?
  addressVerifiedAt      DateTime?
  dateOfBirth            DateTime?
  cniHash                String?   @unique
  smsAlertsEnabled       Boolean   @default(true)
  smsBalanceQueryEnabled Boolean   @default(true)
  email                  String?   @unique
  emailVerifiedAt        DateTime?
  afriId                 String?   @unique
  inviteCode             String?   @unique
  referredByUserId       String?
  studentPassSchool      String?
  studentPassBusinessId  String?
  studentPassStatus      String?
  studentPassRequestedAt DateTime?
  studentPassVerifiedAt  DateTime?
  studentPassExpiresAt   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  wallet                Wallet?
  koriSent              KoriTransaction[]      @relation("KoriSender")
  koriReceived          KoriTransaction[]      @relation("KoriRecipient")
  roles                 AccountRole[]
  refreshTokens         RefreshToken[]
  notifications         Notification[]
  ledgerEntries         LedgerEntry[]
  sellerProfile         SellerProfile?
  driverProfile         DriverProfile?
  workerProfile         WorkerProfile?
  businessMemberships   BusinessMember[]
  ownedBusinesses       Business[]             @relation("BusinessOwner")
  studentPassBusiness   Business?              @relation("StudentPassLink", fields: [studentPassBusinessId], references: [id])
  communityStatuses     BusinessCommunityStatus[]
  sentMessages          MboloMessage[]
  mboloMemberships      MboloMember[]
  createdThreads        MboloThread[]          @relation("ThreadCreator")
  createdTontines       TontineGroup[]         @relation("TontineCreator")
  tontineMemberships    TontineMembership[]
  tontineContributions  TontineContribution[]  @relation("TontineContributor")
  tontinePayouts        TontinePayout[]        @relation("TontinePayoutRecipient")
  createdEvents         Event[]                @relation("EventPromoter")
  tickets               Ticket[]
  deliveryAssignments   DeliveryTask[]         @relation("AssignedDriver")
  hubParcels            HubParcel[]
  moneyRequestsSent     MoneyRequest[]         @relation("MoneyRequester")
  moneyRequestsReceived MoneyRequest[]         @relation("MoneyPayer")
  ordersAsBuyer         Order[]                @relation("OrderBuyer")
  merchantVouchers      MerchantVoucher[]
  railTransactions      RailTransaction[]
  apiIdempotencyKeys    ApiIdempotency[]
  apiAuditLogs          ApiAuditLog[]
  rateLimit             UserRateLimit?
  devices               UserDevice[]
  heldTransactions      HeldTransaction[]
  fraudAlerts           FraudAlert[]
  cniVerificationJobs   CniVerificationJob[]
  dailyUsage            UserDailyUsage[]
  smsMessages           SmsMessage[]
  supportTickets        SupportTicket[]
  supportTicketMessages SupportTicketMessage[]
  supportCallLogs       SupportCallLog[]
  partnerSupportAgents  PartnerSupportAgent[]
  adminRefundsReceived  AdminRefund[]          @relation("RefundRecipient")
  transferUndosSent     TransferUndo[]         @relation("UndoSender")
  transferUndosReceived TransferUndo[]         @relation("UndoRecipient")
  payrollEmployments    PayrollEmployee[]      @relation("PayrollEmployeeUser")
  schoolChildren        SchoolStudent[]        @relation("SchoolParent")
  farmerDeliveries      FarmerDeliveryLog[]    @relation("FarmerDeliveries")
  verifiedDeliveries    FarmerDeliveryLog[]    @relation("VerifiedDeliveries")
  blocksCreated         UserBlock[]            @relation("Blocker")
  blocksReceived        UserBlock[]            @relation("BlockedUser")
  reportsFiled          ContentReport[]        @relation("Reporter")
  reportsReceived       ContentReport[]        @relation("ReportedUser")
  offlineSyncItems      OfflineSyncQueue[]
  friendsInitiated      UserFriend[]           @relation("FriendUser")
  friendsReceived       UserFriend[]           @relation("FriendTarget")
  friendRequestsSent     FriendRequest[]       @relation("FriendRequestFrom")
  friendRequestsReceived FriendRequest[]       @relation("FriendRequestTo")
  vouchesReceived        UserVouch[]           @relation("VouchReceived")
  vouchesGiven           UserVouch[]           @relation("VouchGiven")
  alertReads             AlertRead[]
  businessLedgerHits     BusinessLedgerEntry[]  @relation("BusinessLedgerUserCounterparty")
  agentProfile           AgentProfile?
  agentDeposits          AgentDeposit[]
  agentWithdrawals       AgentWithdrawal[]
  referredBy             User?                  @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals              User[]                 @relation("UserReferrals")
  stripeDeposits         StripeDeposit[]
  paymentFunds           PaymentFund[]
  scheduledPayments      ScheduledPayment[]
  productViews           ProductView[]
  solidarityCampaigns    SolidarityCampaign[]   @relation("SolidarityCreator")
  solidarityBeneficiary  SolidarityCampaign[]   @relation("SolidarityBeneficiary")
  solidarityDonations    SolidarityContribution[] @relation("SolidarityDonor")
  affiliateProfile       AffiliateProfile?
  tradeAccountsAsBuyer   TradeAccount[]           @relation("TradeBuyer")
  tradeInvoicesAsBuyer   TradeInvoice[]           @relation("TradeInvoiceBuyer")
  mediaVault             UserMediaVault?
  mboloMediaAssets       MbooloMediaAsset[]
  mboloGifsCreated       MbooloGif[]              @relation("MbooloGifCreator")
  mboloStories           UserStory[]
  deviceKeys             UserDeviceKey[]

  deliveriesAsBuyer DeliveryTask[] @relation("DeliveryBuyer")
  /// LEGACY (preserved, J2 decision 2026-10-03): exists in the production-shaped baseline; never drop.
  afriClass String?
  legacyKebuInvestments KebuInvestment[]   @relation("LegacyKebuInvestor")
  legacyKoriRedemptions KoriRedemption[]   @relation("LegacyKoriRedemptionUser")
  legacyPromoUses       MerchantPromoUse[] @relation("LegacyPromoUseUser")
  legacyNuLekkShares    NuLekkShare[]      @relation("LegacyNuLekkShareUser")
  legacyNuLekkSplits    NuLekkSplit[]      @relation("LegacyNuLekkSplitCreator")
  legacyTontineContributions LegacyTontineContribution[] @relation("LegacyTontineContributor")
  @@index([phone])
  @@index([afriId])
  @@index([frozenByAdminAt])
  @@index([verificationTier])
  @@index([handle])
  @@index([inviteCode])
  @@index([referredByUserId])
  @@index([afriClass])
}

model AccountRole {
  id        String   @id @default(cuid())
  userId    String
  role      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  /// Wrong guesses against this code; burned at OTP_MAX_ATTEMPTS (lib/otp-service.js).
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  /// Set when this token was exchanged for a new one (rotation). Presenting
  /// a rotated token again later means it was copied: the whole family dies.
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  balance     Int      @default(0)
  koriBalance Int      @default(0)
  currency    String   @default("XOF")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]
}

model KoriTransaction {
  id              String   @id @default(cuid())
  senderId        String?
  recipientId     String?
  amountKori      Int
  transactionType String
  status          String   @default("completed")
  reference       String   @unique
  note            String?
  attachmentUrl   String?  @db.Text
  attachmentType  String?
  giftCardTheme   String?
  createdAt       DateTime @default(now())

  sender    User? @relation("KoriSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient User? @relation("KoriRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([transactionType])
}

model KoriReserve {
  id                     String    @id @default("global")
  totalKoriInCirculation Int       @default(0)
  totalReserveHeldXof    Int       @default(0)
  conversionsFrozen      Boolean   @default(false)
  lastReconciliationAt   DateTime?
  lastReconciliationOk   Boolean?
  lastMismatchXof        Int       @default(0)
  lastUpdated            DateTime  @updatedAt
}

model LedgerEntry {
  id                 String   @id @default(cuid())
  walletId           String
  userId             String
  type               String
  amount             Int
  counterpartyName   String?
  counterpartyHandle String?
  note               String?
  attachmentUrl      String?  @db.Text
  attachmentType     String?
  giftCardTheme      String?
  reference          String   @unique
  createdAt          DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([type])
}

model Business {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  type           String   @default("merchant")
  category       String?
  arrondissement String?
  kebuId         String?  @unique
  description    String?
  statusText     String?
  address        String?
  lat            Float?
  lng            Float?
  imageUrl       String?
  verified       Boolean  @default(false)
  acceptOrdersWhenOutOfStock Boolean @default(false)
  pauseOrders                Boolean @default(false)
  lowStockAlertEnabled       Boolean @default(true)
  distributionEnabled        Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner            User               @relation("BusinessOwner", fields: [ownerId], references: [id])
  members          BusinessMember[]
  products         Product[]
  orders           Order[]
  events           Event[]
  payrollGroups    PayrollGroup[]
  payrollEmployees PayrollEmployee[]
  schoolStudents   SchoolStudent[]
  reviews          Review[]
  schoolFeePeriods SchoolFeePeriod[]
  deliveryLogs     FarmerDeliveryLog[]
  contentReports   ContentReport[]
  blocksReceived   UserBlock[]
  wallet           BusinessWallet?
  businessLedger   BusinessLedgerEntry[]
  ledgerCounterparty BusinessLedgerEntry[] @relation("BusinessLedgerCounterparty")
  studentPassHolders User[]                @relation("StudentPassLink")
  communityStatuses  BusinessCommunityStatus[]
  productViews       ProductView[]
  affiliateLinks     AffiliateLink[]
  merchantVouchers   MerchantVoucher[]
  lockedMoneyRequests MoneyRequest[] @relation("LockedMoneyRequests")
  tradeAccountsSupplied TradeAccount[] @relation("TradeSupplier")
  tradeAccountsAsBuyer  TradeAccount[] @relation("TradeBuyerBusiness")
  tradeInvoicesSupplied TradeInvoice[] @relation("TradeInvoiceSupplier")
  tradeInvoicesAsBuyer  TradeInvoice[] @relation("TradeInvoiceBuyerBusiness")
  ordersAsBuyer         Order[]        @relation("OrderBuyerBusiness")

  /// LEGACY (preserved, J2 decision 2026-10-03): exists in the production-shaped baseline; never drop.
  legacyInvestmentOfferings KebuInvestmentOffering[] @relation("LegacyOfferingBusiness")
  legacyRedemptionOffers    KoriRedemptionOffer[]    @relation("LegacyRedemptionOfferBusiness")
  legacyPromos              MerchantPromo[]          @relation("LegacyPromoBusiness")
  legacyNuLekkSplits        NuLekkSplit[]            @relation("LegacyNuLekkSplitBusiness")
  @@index([ownerId])
  @@index([category])
  @@index([type])
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, role])
  @@index([userId])
}

/**
 * A status posted by someone affiliated with a business rather than the
 * business itself — a student whose K21 Pass is linked to that school, or a
 * staff member. Works like a WhatsApp/Instagram status: one active post per
 * person, shown as a tappable ring, gone after 24h (expiresAt), not a
 * permanent text card.
 */
model BusinessCommunityStatus {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId, expiresAt])
}

/** KEBU business wallet — separate from owner personal AFRI wallet. */
model BusinessWallet {
  id         String   @id @default(cuid())
  businessId String   @unique
  balance    Int      @default(0)
  currency   String   @default("XOF")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  ledgerEntries BusinessLedgerEntry[]

  @@index([businessId])
}

/** Ledger for KEBU wallet — payroll, B2B, owner draw, capital in. */
model BusinessLedgerEntry {
  id                     String   @id @default(cuid())
  businessWalletId       String
  businessId             String
  type                   String
  amount                 Int
  counterpartyBusinessId String?
  counterpartyUserId     String?
  counterpartyName       String?
  counterpartyKebuId     String?
  note                   String?
  reference              String   @unique
  createdAt              DateTime @default(now())

  businessWallet       BusinessWallet @relation(fields: [businessWalletId], references: [id], onDelete: Restrict)
  business             Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  counterpartyBusiness Business?      @relation("BusinessLedgerCounterparty", fields: [counterpartyBusinessId], references: [id], onDelete: SetNull)
  counterpartyUser     User?          @relation("BusinessLedgerUserCounterparty", fields: [counterpartyUserId], references: [id], onDelete: SetNull)

  @@index([businessWalletId, createdAt])
  @@index([businessId, createdAt])
  @@index([type])
}

model SellerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  shopName  String
  category  String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
}

model DriverProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  status       String    @default("offline")
  vehicle      String?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, lastActiveAt])
}

/** Worker mode — only activatable from a personal K21 account (not business signup). */
model WorkerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  workerId            String   @unique
  modes               String   @default("")
  status              String   @default("active")
  reputationScore     Int      @default(0)
  totalEarnedNational Int      @default(0)
  completedJobs       Int      @default(0)
  activatedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts WorkerReceipt[]

  @@index([workerId])
  @@index([status])
}

/** Verifiable proof of completed platform work — for reputation and loan documentation. */
model WorkerReceipt {
  id              String   @id @default(cuid())
  workerProfileId String
  userId          String
  reference       String   @unique
  kind            String
  sourceId        String?
  title           String
  subtitle        String?
  amountNational  Int
  koriAmount      Int      @default(0)
  completedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  worker WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Restrict)

  @@index([workerProfileId, completedAt])
  @@index([userId])
  @@index([kind])
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String?
  businessId  String?
  title       String
  description String?
  imageUrl    String?
  price       Int
  category    String?
  inventory   Int      @default(0)
  trackInventory      Boolean  @default(true)
  allowBackorder      Boolean  @default(false)
  lowStockThreshold   Int      @default(5)
  viewCount           Int      @default(0)
  active      Boolean  @default(true)
  flashPrice  Int?
  flashExpiresAt DateTime?
  unitLabel   String?
  b2bPrice    Int?
  b2bMinQty   Int      @default(1)
  saleChannel String   @default("both")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller     SellerProfile? @relation(fields: [sellerId], references: [id])
  business   Business?      @relation(fields: [businessId], references: [id])
  orderItems OrderItem[]
  views      ProductView[]
  affiliateLinks AffiliateLink[]

  /// LEGACY (preserved, J2 decision 2026-10-03): exists in the production-shaped baseline; never drop.
  legacyPromosAsFree    MerchantPromo[] @relation("LegacyPromoFreeProduct")
  legacyPromosAsTrigger MerchantPromo[] @relation("LegacyPromoTriggerProduct")
  @@index([sellerId])
  @@index([businessId])
  @@index([category])
}

model Order {
  id               String   @id @default(cuid())
  buyerId          String
  businessId       String?
  buyerBusinessId  String?
  status           String   @default("pending")
  channel          String   @default("b2c")
  paymentTerm      String   @default("immediate")
  paymentStatus    String   @default("paid")
  paidAmount       Int      @default(0)
  paymentSource    String   @default("personal")
  preferredDeliveryDate DateTime?
  orderReference   String?  @unique
  fulfillmentType  String   @default("delivery")
  totalAmount      Int
  deliveryAddress  String?
  hubId            String?
  notes            String?
  affiliateLinkCode String?
  mboloThreadId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business?     @relation(fields: [businessId], references: [id])
  buyer    User          @relation("OrderBuyer", fields: [buyerId], references: [id])
  buyerBusiness Business? @relation("OrderBuyerBusiness", fields: [buyerBusinessId], references: [id])
  hub      DeliveryHub?  @relation(fields: [hubId], references: [id])
  items    OrderItem[]
  delivery DeliveryTask?
  hubParcelLastMile HubParcel? @relation("HubParcelLastMile")
  tradeInvoice TradeInvoice?

  /// LEGACY (preserved, J2 decision 2026-10-03): exists in the production-shaped baseline; never drop.
  subtotalKori     Int?
  discountKori     Int      @default(0)
  promoId          String?
  promoCode        String?
  legacyPromo      MerchantPromo?     @relation("LegacyOrderPromo", fields: [promoId], references: [id])
  legacyPromoUses  MerchantPromoUse[] @relation("LegacyPromoUseOrder")
  @@index([buyerId])
  @@index([businessId])
  @@index([buyerBusinessId])
  @@index([status])
  @@index([paymentStatus])
  @@index([preferredDeliveryDate])
  @@index([hubId])
  @@index([promoId])
}

model DeliveryHub {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  address        String
  lat            Float
  lng            Float
  arrondissement String?
  city           String?
  country        String   @default("SN")
  isWarehouse    Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders        Order[]
  deliveryTasks DeliveryTask[]
  hubParcels    HubParcel[]

  @@index([active])
  @@index([country, city])
}

/** Inbound parcel to a K-21 pickup point — international, regional, or personal shipments. */
model HubParcel {
  id              String    @id @default(cuid())
  ownerId         String
  hubId           String
  reference       String    @unique
  externalRef     String?
  originCountry   String
  originLabel     String?
  description     String
  senderName      String?
  senderContact   String?
  status          String    @default("registered")
  fulfillmentPlan String    @default("pickup")
  dropoffArea     String?
  dropoffAddress  String?
  dropoffLat      Float?
  dropoffLng      Float?
  pickupCode      String?
  lastMileOrderId String?   @unique
  arrivedAt       DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  hub           DeliveryHub  @relation(fields: [hubId], references: [id])
  lastMileOrder Order?       @relation("HubParcelLastMile", fields: [lastMileOrderId], references: [id])

  @@index([ownerId, status])
  @@index([hubId, status])
  @@index([status])
  @@index([pickupCode])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id])

  /// LEGACY (preserved, J2 decision 2026-10-03): exists in the production-shaped baseline; never drop.
  isPromoFree Boolean        @default(false)
  promoId     String?
  legacyPromo MerchantPromo? @relation("LegacyOrderItemPromo", fields: [promoId], references: [id])
  @@index([orderId])
  @@index([productId])
  @@index([promoId])
}

/** B2B buyer account with a supplier brand — pricing tier and payment terms. */
model TradeAccount {
  id                 String   @id @default(cuid())
  supplierBusinessId String
  buyerUserId        String
  buyerBusinessId    String?
  buyerLabel         String?
  buyerType          String   @default("merchant")
  paymentTerm        String   @default("net30")
  creditLimitKori    Int      @default(0)
  codEnabled         Boolean  @default(false)
  trustTier          String   @default("new")
  codLimitKori       Int      @default(50000)
  priceLockUntil     DateTime?
  active             Boolean  @default(true)
  lastKnownBuyerScore Int?
  lastKnownBuyerTier  String?
  lastScoreCheckAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  supplier      Business       @relation("TradeSupplier", fields: [supplierBusinessId], references: [id], onDelete: Cascade)
  buyer         User           @relation("TradeBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  buyerBusiness Business?      @relation("TradeBuyerBusiness", fields: [buyerBusinessId], references: [id], onDelete: SetNull)
  invoices      TradeInvoice[]

  @@unique([supplierBusinessId, buyerUserId])
  @@index([buyerUserId])
  @@index([supplierBusinessId, active])
}

/** Open invoice for B2B orders — collect later per trade terms. */
model TradeInvoice {
  id                 String    @id @default(cuid())
  supplierBusinessId String
  buyerUserId        String
  buyerBusinessId    String?
  tradeAccountId     String?
  orderId            String?   @unique
  reference          String    @unique
  amountKori         Int
  amountPaid         Int       @default(0)
  status             String    @default("open")
  dueAt              DateTime
  paidAt             DateTime?
  reminderSentAt     DateTime?
  notes              String?
  disputeReason         String?
  disputedAt            DateTime?
  disputeResolutionNote String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  supplier      Business      @relation("TradeInvoiceSupplier", fields: [supplierBusinessId], references: [id], onDelete: Restrict)
