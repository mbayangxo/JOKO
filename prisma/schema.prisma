  pickupType          String    @default("merchant")
  pickupLabel         String?
  pickupAddress       String?
  pickupLat           Float?
  pickupLng           Float?
  dropoffArea         String
  dropoffExact        String?
  dropoffLat          Float?
  dropoffLng          Float?
  dropoffAddress      String
  deliveryFeeNational Int       @default(1500)
  riderKoriEarnings   Int       @default(10)
  estimatedMinutes    Int       @default(25)
  status              String    @default("open")
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  confirmedAt         DateTime?
