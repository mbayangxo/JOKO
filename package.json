{
  "name": "joko",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@prisma/client": "6.19.3",
    "@react-navigation/bottom-tabs": "^7.18.5",
    "@react-navigation/native": "^7.3.5",
    "@react-navigation/native-stack": "^7.17.7",
    "@sentry/node": "^10.63.0",
    "@sentry/react-native": "^8.17.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "expo": "~57.0.1",
    "expo-audio": "~57.0.0",
    "expo-blur": "^57.0.0",
    "expo-camera": "~57.0.3",
    "expo-device": "^57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "^57.0.0",
    "expo-haptics": "^57.0.0",
    "expo-image-manipulator": "~57.0.2",
    "expo-image-picker": "~57.0.2",
    "expo-linear-gradient": "^57.0.0",
    "expo-local-authentication": "^57.0.0",
    "expo-screen-capture": "^57.0.0",
    "expo-secure-store": "^57.0.0",
    "expo-splash-screen": "^57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-video": "~57.0.2",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.17.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "stripe": "^17.7.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "npm run vercel-build",
    "vercel-build": "node scripts/prisma-generate.mjs && node scripts/db-migrate-deploy.mjs && EXPO_NO_TELEMETRY=1 npx expo export --platform web",
    "db:migrate:deploy": "node scripts/db-migrate-deploy.mjs",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:push": "node scripts/db-setup.mjs",
    "db:seed-beta": "node scripts/db-seed-beta.mjs",
    "dev:api": "vercel dev",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "node scripts/prisma-cli.mjs migrate dev",
    "db:resolve-baseline": "node scripts/db-resolve-baseline.mjs",
    "db:studio": "node scripts/prisma-cli.mjs studio",
    "pretest": "node scripts/ensure-test-db.mjs",
    "pretest:one": "node scripts/ensure-test-db.mjs",
    "test:db:start": "prisma dev --name joko-test --detach",
    "test:db:setup": "prisma db push --skip-generate && prisma db execute --schema prisma/schema.prisma --file prisma/sql/financial-invariants.sql && prisma db execute --schema prisma/schema.prisma --file prisma/sql/money-kernel.sql && prisma db execute --schema prisma/schema.prisma --file prisma/sql/identity-guards.sql && prisma generate",
    "test:db:stop": "prisma dev stop joko-test",
    "test": "node --test --test-concurrency=1 \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\" \"tests/security/**/*.test.js\" \"tests/http/**/*.test.js\" \"tests/money/**/*.test.js\" \"tests/j3/**/*.test.js\" \"tests/j4/**/*.test.js\" \"tests/j5/**/*.test.js\"",
    "test:one": "node --test --test-concurrency=1",
    "test:unit": "node --test --test-concurrency=1 \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:marketplace": "node --test --test-concurrency=1 tests/integration/marketplace-flow.test.js",
    "verify:marketplace": "node scripts/verify-marketplace-e2e.mjs",
    "test:security": "node --test --test-concurrency=1 \"tests/security/**/*.test.js\"",
    "money:backfill": "node scripts/money-backfill.mjs",
    "money:rehearse": "node scripts/rehearse-migration.mjs",
    "money:check": "node scripts/money-check.mjs",
    "test:j3": "node --test --test-concurrency=1 \"tests/j3/**/*.test.js\"",
    "test:j4": "node --test --test-concurrency=1 \"tests/j4/**/*.test.js\"",
    "test:j5": "node --test --test-concurrency=1 \"tests/j5/**/*.test.js\"",
    "test:money": "node --test --test-concurrency=1 \"tests/money/**/*.test.js\"",
    "test:sweep": "node --test --test-concurrency=1 \"tests/sweep/**/*.test.js\"",
    "test:http": "node --test --test-concurrency=1 \"tests/http/**/*.test.js\"",
    "test:load": "node --test --test-concurrency=1 --test-timeout=600000 \"tests/load/**/*.test.js\"",
    "test:launch-gate": "node --test --test-concurrency=1 --test-timeout=600000 \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\" \"tests/security/**/*.test.js\" \"tests/http/**/*.test.js\" \"tests/load/**/*.test.js\"",
    "test:resend-email": "node scripts/test-resend-email.mjs",
    "user:set-password": "node scripts/set-user-password.mjs",
    "business:backfill-wallets": "node scripts/backfill-business-wallets.mjs",
    "kori:migrate-primary": "node scripts/migrate-kori-primary.mjs"
  },
  "private": true
}
